   2 LET ORG=24576
   3 LOAD FAST
  10 FAST 
  12 LOAD *FULLPAG
  15 LOAD THEN CLEAR ORG-1
  20 LOAD FAST "/EXPLORER/EXPLORER.BIN" CODE ORG
  30 LET N=USR ORG
  40 IF N=0 THEN STOP 
  50 LET F$=""
  55 LET EXT = 255
  60 FOR I=0 TO N-1
  65 LET A$=CHR$ (PEEK (ORG+3+I))
  67 IF A$="." THEN LET EXT = I+1
  70 LET F$=F$+A$
  80 NEXT I
  85 SLOW 
  90 LET E$=F$(EXT TO )
  95 LOAD THEN CLEAR 32768
 100 IF (E$ = ".P") OR (E$=".WAV") OR (E$=".ROM") THEN LOAD FAST F$
 110 IF (E$ = ".SCR") THEN GOTO 1000
 120 IF (E$ = ".VGM") THEN GOTO 1500
 300 GOTO 10
 1000 FAST
 1005 LOAD *COLOR
 1010 LOAD *SFSP 32768
 1020 LOAD FAST F$ CODE 32768
 1030 IF INKEY$="" THEN GOTO 1030
 1040 LOAD *COLOR STOP
 1050 LOAD *SFSP STOP
 1060 GOTO 10
 1500 FAST
 1510 LOAD *VGM F$
 1520 LOAD *VGM THEN RUN
 1530 GOTO 10